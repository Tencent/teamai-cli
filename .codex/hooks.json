{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc \"teamai hook-dispatch session-start --tool codex 2>/dev/null\" || true",
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc \"teamai hook-dispatch stop --tool codex 2>/dev/null\" || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc \"teamai hook-dispatch post-tool-use --tool codex 2>/dev/null\" || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc \"teamai hook-dispatch post-tool-use --tool codex --matcher Skill 2>/dev/null\" || true"
          }
        ],
        "matcher": "Skill"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc \"teamai hook-dispatch post-tool-use --tool codex --matcher TodoWrite 2>/dev/null\" || true"
          }
        ],
        "matcher": "TodoWrite"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc \"teamai hook-dispatch prompt-submit --tool codex 2>/dev/null\" || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc \"teamai hook-dispatch subagent-stop --tool codex 2>/dev/null\" || true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc \"teamai hook-dispatch subagent-start --tool codex 2>/dev/null\" || true",
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
