schemaVersion: v1alpha1
title: Restore the queue retry delay
prompt: Set `retryDelayMs()` in limits.cjs to the value specified by team policy.
startingCommit: PROJECT_COMMIT
covers: [rules/queue-retry.md, docs/queue-retry.md]
check:
  run: node .related-recall-check.cjs
  protect: ['.related-recall-check.cjs']
  add:
    - from: check-files/retry-delay.cjs
      to: .related-recall-check.cjs
