{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc \"teamai hook-dispatch session-start --tool codex-internal 2>/dev/null\" || true",
            "statusMessage": "teamai-SessionStart",
            "commandWindows": "cmd.exe /d /s /c \"teamai hook-dispatch session-start --tool codex-internal 2>nul & exit /b 0\"",
            "timeout": 15,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc \"teamai hook-dispatch stop --tool codex-internal 2>/dev/null\" || true",
            "statusMessage": "teamai-Stop",
            "commandWindows": "cmd.exe /d /s /c \"teamai hook-dispatch stop --tool codex-internal 2>nul & exit /b 0\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.teamai/bin/teamai\" ]; then TEAMAI_HOOK_LOGIN=deferred \"$HOME/.teamai/bin/teamai\" hook-dispatch post-tool-use --tool codex-internal 2>/dev/null; else bash -lc \"teamai hook-dispatch post-tool-use --tool codex-internal 2>/dev/null\"; fi || true",
            "statusMessage": "teamai-PostToolUse",
            "commandWindows": "cmd.exe /d /s /c \"teamai hook-dispatch post-tool-use --tool codex-internal 2>nul & exit /b 0\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.teamai/bin/teamai\" ]; then TEAMAI_HOOK_LOGIN=deferred \"$HOME/.teamai/bin/teamai\" hook-dispatch prompt-submit --tool codex-internal 2>/dev/null; else bash -lc \"teamai hook-dispatch prompt-submit --tool codex-internal 2>/dev/null\"; fi || true",
            "statusMessage": "teamai-UserPromptSubmit",
            "commandWindows": "cmd.exe /d /s /c \"teamai hook-dispatch prompt-submit --tool codex-internal 2>nul & exit /b 0\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc \"teamai hook-dispatch subagent-stop --tool codex-internal 2>/dev/null\" || true",
            "statusMessage": "teamai-SubagentStop",
            "commandWindows": "cmd.exe /d /s /c \"teamai hook-dispatch subagent-stop --tool codex-internal 2>nul & exit /b 0\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc \"teamai hook-dispatch subagent-start --tool codex-internal 2>/dev/null\" || true",
            "statusMessage": "teamai-SubagentStart",
            "commandWindows": "cmd.exe /d /s /c \"teamai hook-dispatch subagent-start --tool codex-internal 2>nul & exit /b 0\"",
            "timeout": 15,
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
