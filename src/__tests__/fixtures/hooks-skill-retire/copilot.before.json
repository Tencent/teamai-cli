{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "bash": "bash -lc \"teamai hook-dispatch session-start --tool copilot 2>/dev/null\" || true",
        "powershell": "teamai hook-dispatch session-start --tool copilot 2>$null; exit 0",
        "command": "bash -lc \"teamai hook-dispatch session-start --tool copilot 2>/dev/null\" || true",
        "timeoutSec": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "bash": "bash -lc \"teamai hook-dispatch stop --tool copilot 2>/dev/null\" || true",
        "powershell": "teamai hook-dispatch stop --tool copilot 2>$null; exit 0",
        "command": "bash -lc \"teamai hook-dispatch stop --tool copilot 2>/dev/null\" || true",
        "timeoutSec": 15
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "bash": "bash -lc \"teamai hook-dispatch post-tool-use --tool copilot 2>/dev/null\" || true",
        "powershell": "teamai hook-dispatch post-tool-use --tool copilot 2>$null; exit 0",
        "command": "bash -lc \"teamai hook-dispatch post-tool-use --tool copilot 2>/dev/null\" || true",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "bash -lc \"teamai hook-dispatch post-tool-use --tool copilot --matcher Skill 2>/dev/null\" || true",
        "powershell": "teamai hook-dispatch post-tool-use --tool copilot --matcher Skill 2>$null; exit 0",
        "command": "bash -lc \"teamai hook-dispatch post-tool-use --tool copilot --matcher Skill 2>/dev/null\" || true",
        "matcher": "skill",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "bash -lc \"teamai hook-dispatch post-tool-use --tool copilot --matcher TodoWrite 2>/dev/null\" || true",
        "powershell": "teamai hook-dispatch post-tool-use --tool copilot --matcher TodoWrite 2>$null; exit 0",
        "command": "bash -lc \"teamai hook-dispatch post-tool-use --tool copilot --matcher TodoWrite 2>/dev/null\" || true",
        "matcher": "TodoWrite",
        "timeoutSec": 3
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "bash": "bash -lc \"teamai hook-dispatch prompt-submit --tool copilot 2>/dev/null\" || true",
        "powershell": "teamai hook-dispatch prompt-submit --tool copilot 2>$null; exit 0",
        "command": "bash -lc \"teamai hook-dispatch prompt-submit --tool copilot 2>/dev/null\" || true",
        "timeoutSec": 10
      }
    ],
    "SessionEnd": [
      {
        "type": "command",
        "bash": "bash -lc \"teamai hook-dispatch session-end --tool copilot 2>/dev/null\" || true",
        "powershell": "teamai hook-dispatch session-end --tool copilot 2>$null; exit 0",
        "command": "bash -lc \"teamai hook-dispatch session-end --tool copilot 2>/dev/null\" || true",
        "timeoutSec": 15
      }
    ]
  }
}
