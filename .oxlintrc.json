{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // oxlint's defaults, and import for import/no-cycle: the module graph it needs is built only when import is on here.
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "jsPlugins": ["./oxlint-plugin-teamai/index.js"],
  "ignorePatterns": [
    // Agent tooling a member's tools install into the checkout: their skills and hooks, not this repository's source.
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    // Vendored unchanged from anti-slop, and linted there.
    "oxlint-plugin-teamai/anti-slop/rules/**",
    "oxlint-plugin-teamai/anti-slop/shared/**",
    "oxlint-plugin-teamai/anti-slop/vendor/**"
  ],
  "categories": {
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "typescript/no-floating-promises": "warn",
    "typescript/no-misused-promises": "warn",
    // Prefer includes() when checking for a collection member.
    "unicorn/prefer-includes": "warn",
    // Prefer a predicate search when only the existence of a match matters.
    "unicorn/prefer-array-some": "warn",
    // These Unicorn rules are not covered by the pinned categories; keep
    // their policy explicit even while the current tree is clean.
    "unicorn/prefer-array-flat": "warn",
    "unicorn/prefer-array-flat-map": "warn",
    "unicorn/prefer-string-trim-start-end": "warn",
    // A switch default already handles the generic JSON webhook; a duplicate
    // `case 'json'` obscures that there is no separate JSON branch.
    "unicorn/no-useless-switch-case": "warn",
    // Exact string lookups should use indexOf() rather than allocating a
    // predicate for findIndex().
    "unicorn/prefer-array-index-of": "warn",
    "typescript/no-base-to-string": "off",
    "typescript/no-duplicate-type-constituents": "off",
    "typescript/no-implied-eval": "off",
    "typescript/no-meaningless-void-operator": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/await-thenable": "off",
    "typescript/require-array-sort-compare": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/unbound-method": "off",
    // The suspicious/perf categories also reach these type-aware rules; only
    // no-floating-promises and no-misused-promises (#863) are on.
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/no-unnecessary-type-conversion": "off",
    "typescript/consistent-return": "off",
    "typescript/no-unnecessary-boolean-literal-compare": "warn",
    "typescript/no-unnecessary-template-expression": "off",
    "typescript/no-unnecessary-type-arguments": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    // Sequential awaits are deliberate in a CLI (git, prompts, ordered
    // writes); the rule can't tell an intentional ordering dependency from
    // a parallelizable loop.
    "no-await-in-loop": "off",
    // All prod sort sites sort a local array built in the same function;
    // none mutates a caller's array, so the in-place warning doesn't apply.
    "unicorn/no-array-sort": "off",
    // Unlike sorting, reversal is required to stay non-mutating so future
    // callers cannot observe an incidental in-place change to a local copy.
    "unicorn/no-array-reverse": "warn",
    // Moves closures to outer scope; a style preference, not a bug class.
    "unicorn/consistent-function-scoping": "off",
    // Conflicts with this repo's own `_` convention (`_setLogFilePath`,
    // `_resetState`).
    "no-underscore-dangle": "off",
    // Micro-optimization, not worth the churn.
    "oxc/no-map-spread": "off",
    // Pull deletes a delivered copy and its record entry together (#1577).
    "teamai/remove-delivered": "error",
    // An attempt's result file is written masked, through AttemptResult.write.
    "teamai/attempt-result-writes": "error",
    // A step's work is committed with untrustedGit, so no hook it planted runs on the host.
    "teamai/untrusted-finish-git": "error",
    "teamai/git-exit-code": "error",
    "teamai/piped-git": "error",
    "teamai/spawn-command": "error",
    // readline re-emits a socket's or stream's errors on its interface, and throws them when nothing listens there.
    "teamai/readline-error": "error",
    // Linux answers from /proc the process reads macOS runs ps for, and the agent wait budget counts only what it is told on Linux.
    "teamai/process-reads": "error",
    // A ChildProcess built with new backs no process, and its kill signals pid 0: the process group of the whole run.
    "teamai/unspawned-child": "error",
    // process.kill(0) signals the caller's own process group, -1 every process it may signal, and so does a failed spawn's kill on Node 20: a signal goes through process-group.
    "teamai/signal-owner": "error",
    // A recursive readdir enters a link to a folder: out of the folder it lists, or round a loop that never ends.
    "teamai/recursive-readdir": "error",
    // A step writes the paths the engine reads; a FIFO it leaves there would block a plain read past every deadline.
    "teamai/regular-file-reads": "error",
    // Opening a FIFO for writing blocks until a reader comes, as a read blocks until a writer does.
    "teamai/step-path-writes": "error",
    // getUserHome owns the HOME / USERPROFILE fallback that keeps Windows paths safe.
    "teamai/home-env": "error",
    "teamai/learnings-root": "error",
    "teamai/configured-tool-paths": "error",
    "teamai/config-load-options": "error",
    "teamai/launch-env": "error",
    "teamai/attempt-marker-reads": "error",
    "teamai/launch-through-workflows": "error",
    "teamai/workflow-boundaries": "error",
    "teamai/no-provider-merge": "error",
    "teamai/windows-tests": "error",
    "teamai/launcher-conformance": "error",
    "teamai/rules-locate": "error",
    "teamai/workflow-failure-codes": "error",
    "teamai/tool-facts": "error",
    // A tool family builds argv and reads output, and never starts a process; its index.ts exports only `family`.
    "teamai/tool-family-shape": "error",
    // packages/* never imports src/, src/ never imports a runtime package, and a package is reached only by its name.
    "teamai/package-boundaries": "error",
    // A runtime serves protocol 1 only through @teamai/runtime-kit: no request loop or op end of its own.
    "teamai/runtime-serve": "error",
    // A package's test reaches its own package only through the module it is named after, src/testing/ and the package's exports.
    "teamai/test-seams": "error",
    // TOOLS, LAUNCH_ADAPTERS and ADAPTER_REGISTRY are read only through src/tool-registry.ts.
    "teamai/tool-registry": "error",
    // A test mocks a module where it is defined: a mock of a re-export misses package code that imports the module itself.
    "teamai/mock-source": "error",
    // parseYaml returns JSON values; yaml's own parse can return a Set, Buffer or Date.
    "teamai/yaml-parse": "error",
    "teamai/uncached-entry": "error",
    // Startup and the facts modules load a tool family's facts only; its adapters, launch profiles and schemas load on first use.
    "teamai/family-facts": "error",
    // git worktree remove --force deletes every worktree inside the one it removes: only removeWorktree removes one, and refuses that.
    "teamai/worktree-removal": "error",
    // V2 has priority over V1: the OpenCode major teamai takes where it reads none is ASSUMED_OPENCODE_MAJOR, decided once.
    "teamai/opencode-major": "error",
    "teamai/shipped-tool-ids": "error",
    // toolCommandEnv decides which variables start a tool's command in which home; a variable set elsewhere skips an instance's own or its recorded home.
    "teamai/tool-home-env": "error",
    // A reducer that copies its accumulator each step is quadratic.
    "oxc/no-accumulating-spread": "error",
    // The generic rules of anti-slop (#828), vendored in
    // oxlint-plugin-teamai/anti-slop. Production code only: see overrides.
    "teamai/no-array-filter-map": "error",
    "teamai/no-chained-type-assertions": "error",
    "teamai/no-conditional-empty-object-spread": "error",
    "teamai/no-known-value-widening": "error",
    "teamai/no-module-mocking": "error",
    "teamai/no-object-parameters": "error",
    "teamai/no-reduce-accumulator-copy": "error",
    "teamai/no-reflect-apply": "error",
    "teamai/no-reflect-get": "error",
    "teamai/no-runtime-typeof": "error",
    "teamai/no-shape-in-symbol-names": "error",
    "teamai/no-unknown-parameters": "error",
    "teamai/no-unknown-returns": "error",
    "teamai/no-unknown-type-aliases": "error",
    "teamai/no-unsafe-dictionary-type": "error",
    "teamai/no-widen-then-assert": "error",
    "teamai/require-readable-spacing": "error",
    "teamai/require-safety-comment-for-type-assertion": "error",
    // CONTRIBUTING: comments explain why, not what.
    "teamai/no-low-value-comments": "error",
    // A suppression with no reason can't be reviewed or removed later.
    "teamai/suppression-reason": "error",
    // `fs.readFile` off a default import is how this repository reads files; the rule would flag every one.
    "import/no-named-as-default-member": "off"
  },
  "overrides": [
    {
      // No import cycle in production source: a module in a cycle can be read before it is initialized, and a cycle
      // joins two concepts that should have one owner. A cycle of type-only imports is allowed: it is erased.
      "files": ["src/**", "packages/*/src/**"],
      "excludeFiles": ["src/__tests__/**", "**/*.test.ts", "src/testing/**", "packages/*/src/testing/**"],
      "rules": { "import/no-cycle": ["error", { "ignoreTypes": true }] }
    },
    {
      // The anti-slop rules hold production code. Tests build partial and
      // malformed values on purpose, and CONTRIBUTING asks them to mock
      // external I/O (git, fetch, child_process) at the module boundary.
      "files": ["src/__tests__/**", "**/*.test.ts", "oxlint-plugin-teamai/test/**"],
      "rules": {
        "teamai/no-array-filter-map": "off",
        "teamai/no-chained-type-assertions": "off",
        "teamai/no-conditional-empty-object-spread": "off",
        "teamai/no-known-value-widening": "off",
        "teamai/no-module-mocking": "off",
        "teamai/no-object-parameters": "off",
        "teamai/no-reduce-accumulator-copy": "off",
        "teamai/no-reflect-apply": "off",
        "teamai/no-reflect-get": "off",
        "teamai/no-runtime-typeof": "off",
        "teamai/no-shape-in-symbol-names": "off",
        "teamai/no-unknown-parameters": "off",
        "teamai/no-unknown-returns": "off",
        "teamai/no-unknown-type-aliases": "off",
        "teamai/no-unsafe-dictionary-type": "off",
        "teamai/no-widen-then-assert": "off",
        "teamai/require-readable-spacing": "off",
        "teamai/require-safety-comment-for-type-assertion": "off"
      }
    },
    {
      // A package's src/testing/ is test support, which teamai/package-boundaries keeps everything that ships from
      // importing, so it builds the loose records tests build.
      "files": ["src/testing/**", "packages/*/src/testing/**"],
      "rules": {
        "teamai/no-unsafe-dictionary-type": "off"
      }
    },
    {
      // Paseo is a prerequisite the member installs: teamai-runtime-paseo loads its client from that install
      // (daemon/client.ts), so shipped code imports only its types, and the bundle holds none of its code.
      "files": ["packages/runtime-paseo/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@getpaseo/*", "ws"],
                "allowTypeImports": true,
                "message": "Import only types from Paseo's packages: the runtime loads them from the member's Paseo install (daemon/client.ts)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/runtime-paseo/src/testing/**", "packages/runtime-paseo/src/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/__tests__/**"],
      "rules": {
        "typescript/no-misused-promises": [
          "warn",
          { "checksVoidReturn": { "arguments": false } }
        ]
      }
    }
  ]
}
